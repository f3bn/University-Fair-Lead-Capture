# Database
DATABASE_URL="mysql://user:password@localhost:3306/lead_capture"

# MySQL Docker (for docker-compose)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=lead_capture
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password

# App
NODE_ENV=development
# Secret for signing guest tokens (required for public logo display)
APP_SECRET="replace-with-strong-secret"

# Security
# Comma-separated allowlist for API CORS/origin checks
ALLOWED_ORIGINS="http://localhost:3000"
ALLOWED_HOSTS="localhost:3000"
# Trust proxy headers (set true behind a reverse proxy/load balancer)
TRUST_PROXY=false
# Session settings
SESSION_TTL_MINUTES=240
SESSION_REFRESH_MINUTES=30
# Upload limits
UPLOAD_MAX_BYTES=10485760
LOGO_MAX_BYTES=5242880
# Export limits
EXPORT_MAX_ROWS=5000
EXPORT_PDF_TIMEOUT_MS=30000
# Login rate limiting/lockout
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MS=900000
LOGIN_LOCKOUT_DURATION_MS=900000
# Optional puppeteer executable path
PUPPETEER_EXECUTABLE_PATH=
